# Supabase — Dunamis Space
# Copie para .env e preencha. A connection string com a senha do Postgres NÃO entra aqui.
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cache (Redis/Upstash) — OPCIONAL. Sem estas vars o app funciona normal (sem cache).
# Crie um banco em https://console.upstash.com e cole as credenciais REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Faxina automática dos prints do SOS (cron da Vercel, ver vercel.json).
# Sem estas duas a rota /api/sos/limpeza responde 401/500 e nada é apagado.
# - CRON_SECRET: qualquer string longa; a Vercel a envia no Authorization do cron.
# - SUPABASE_SERVICE_ROLE_KEY: Supabase > Project Settings > API Keys (service_role).
#   NUNCA vai para o cliente — é lida só em +server.ts.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
